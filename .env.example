GATEWAY_API_KEY=replace-with-a-long-random-secret
DEFAULT_MODEL=
AGY_DEFAULT_MODEL=
OPENCODE_DEFAULT_MODEL=
# Optional OpenCode model filter: all (default), go, zen, or comma-separated prefixes (e.g. opencode-go,anthropic)
OPENCODE_MODEL_FILTER=
ENABLED_PROVIDERS=codex,agy,opencode
MAX_CONCURRENT_JOBS=1
JOB_TIMEOUT_SECONDS=120
CHAT_WAIT_SECONDS=90
JOB_TTL_SECONDS=3600
CORS_ORIGINS=http://localhost:8088
LOG_REQUEST_BODIES=false
