GATEWAY_API_KEY=replace-with-a-long-random-secret
DEFAULT_MODEL=
AGY_DEFAULT_MODEL=
OPENCODE_DEFAULT_MODEL=
# Optional OpenCode model filter: all (default), go, zen, or comma-separated prefixes (e.g. opencode-go,anthropic)
OPENCODE_MODEL_FILTER=
ENABLED_PROVIDERS=codex,agy,opencode
MAX_CONCURRENT_JOBS=1
JOB_TIMEOUT_SECONDS=120
CHAT_WAIT_SECONDS=90
JOB_TTL_SECONDS=3600
CORS_ORIGINS=http://localhost:8088
LOG_REQUEST_BODIES=false
WORKER_TRACE=false

# Shared workspace folder used by all worker CLIs (in both chat and agent modes)
CLI_WORKSPACE_DIR=/work

# Agent mode permissions & Docker-network access (chat mode stays isolated)
AGENT_ALLOW_NETWORK=true
AGY_TOOL_PERMISSION=proceed-in-sandbox
CODEX_AGENT_SANDBOX=workspace-write

# Option A: Remote n8n MCP Server (e.g. http://n8n:5678/mcp/<path>)
N8N_MCP_URL=
N8N_MCP_BEARER_TOKEN=
N8N_MCP_AUTH_HEADER=

# Option B: Built-in stdio MCP bridge for n8n Webhook nodes (agent mode only)
N8N_WEBHOOK_BASE_URL=
N8N_WEBHOOK_TOKEN=
N8N_WEBHOOK_AUTH_HEADER=Authorization
N8N_WEBHOOK_TOOLS_FILE=
N8N_WEBHOOK_TOOLS_JSON=

# Selectable OpenAI tools / tool_calls strategy: auto | client | worker | off
DEFAULT_TOOL_EXECUTION=auto
